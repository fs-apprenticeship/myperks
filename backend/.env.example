DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/myperks_development
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
CLERK_ISSUER=https://your-app.clerk.accounts.dev
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
ALLOWED_ORIGINS=http://localhost:3000


# ───── Email notifications (Resend) ─────
# Create a key at resend.com. Sends only happen when the flag below is true.
RESEND_API_KEY=re_...
# Resend's shared test sender delivers only to your own signup address.
NOTIFICATIONS_FROM_EMAIL=onboarding@resend.dev
# Keep false in local dev and CI; set true only where real delivery is wanted.
NOTIFICATIONS_EMAIL_ENABLED=false
